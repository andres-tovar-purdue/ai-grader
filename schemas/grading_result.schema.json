{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preliminary Student Grading Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "criteria",
    "task_feedback",
    "review_required",
    "review_reasons"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "pattern": "^Student_[0-9]{3}$"
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion_result"
      }
    },
    "task_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "feedback"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "feedback": {
            "type": "string"
          }
        }
      }
    },
    "review_required": {
      "type": "boolean"
    },
    "review_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "criterion_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "agent_score",
        "deductions",
        "justification",
        "evidence",
        "evidence_state",
        "confidence",
        "review_required",
        "review_reasons"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_score": {
          "type": "number",
          "minimum": 0
        },
        "deductions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "points",
              "reason",
              "deduction_type",
              "cause_id",
              "independent_requirement",
              "rule_id"
            ],
            "properties": {
              "points": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "deduction_type": {
                "type": "string",
                "enum": [
                  "demonstrated_technical_error",
                  "missing_required_deliverable",
                  "missing_required_documentation",
                  "inadequate_required_evidence",
                  "hidden_detail_unverifiable",
                  "downstream_consequence"
                ]
              },
              "cause_id": {
                "type": "string",
                "minLength": 1
              },
              "independent_requirement": {
                "type": "boolean"
              },
              "rule_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_path",
              "evidence_type",
              "location"
            ],
            "properties": {
              "artifact_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_type": {
                "type": "string",
                "enum": [
                  "source_code",
                  "image",
                  "file_presence",
                  "unverifiable"
                ]
              },
              "location": {
                "type": "string"
              }
            }
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "verified",
            "demonstrated_error",
            "missing_required_evidence",
            "inadequate_required_evidence",
            "hidden_detail_unverifiable",
            "mixed"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
