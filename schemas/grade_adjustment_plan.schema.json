{
  "$comment": "Final grade adjustment plan: what adjust-grades applies to the reviewed grades. Written by the model from the instructor's instructions (strict structured output) or supplied with --plan-file. Every property is required; unused values are null or empty lists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "curve", "targets", "score_mappings", "student_overrides",
               "rounding", "comment_rules", "student_comments", "not_supported"],
  "properties": {
    "summary": {
      "description": "Each adjustment restated in one plain sentence for the instructor, using Student_### IDs.",
      "type": "array", "items": {"type": "string"}
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "solve_for_targets", "points", "fraction", "slope", "intercept"],
      "properties": {
        "method": {"type": "string", "enum": ["none", "add", "scale", "linear"]},
        "solve_for_targets": {"type": "boolean"},
        "points": {"type": ["number", "null"]},
        "fraction": {"type": ["number", "null"]},
        "slope": {"type": ["number", "null"]},
        "intercept": {"type": ["number", "null"]}
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_grade", "mean", "median", "student_floors"],
      "properties": {
        "min_grade": {"type": ["number", "null"]},
        "mean": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "student_floors": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["student_id", "at_least"],
            "properties": {"student_id": {"type": "string"}, "at_least": {"type": "number"}}
          }
        }
      }
    },
    "score_mappings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_min", "from_max", "to"],
        "properties": {"from_min": {"type": "number"}, "from_max": {"type": "number"},
                       "to": {"type": "number"}}
      }
    },
    "student_overrides": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["student_id", "set_grade", "add_points", "reason"],
        "properties": {"student_id": {"type": "string"},
                       "set_grade": {"type": ["number", "null"]},
                       "add_points": {"type": ["number", "null"]},
                       "reason": {"type": "string"}}
      }
    },
    "rounding": {"type": "string", "enum": ["whole", "half", "none"]},
    "comment_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_min", "from_max", "based_on", "opener"],
        "properties": {"from_min": {"type": "number"}, "from_max": {"type": "number"},
                       "based_on": {"type": "string", "enum": ["before", "after"]},
                       "opener": {"type": "string"}}
      }
    },
    "student_comments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["student_id", "text", "replace"],
        "properties": {"student_id": {"type": "string"}, "text": {"type": "string"},
                       "replace": {"type": "boolean"}}
      }
    },
    "not_supported": {
      "description": "Instructions that none of the fields above can express, quoted or paraphrased. Never guessed into another field.",
      "type": "array", "items": {"type": "string"}
    }
  }
}
