{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Project Grading Specification",
  "description": "Schema for an instructor-approved, project-specific grading specification generated by the Engineering Project Grader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_version",
    "status",
    "project",
    "sources",
    "deliverables",
    "tasks",
    "known_ambiguities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "spec_version": {
      "type": "string",
      "minLength": 1,
      "description": "Version identifier for this project-specific grading specification."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deliverable"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "known_ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "global_review_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "grading_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discussion_policy": {
          "type": "string",
          "enum": [
            "rubric",
            "presence_only"
          ]
        },
        "filename_policy": {
          "type": "string",
          "enum": [
            "rubric",
            "warning_only"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "title",
        "total_points"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string"
        },
        "term": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "total_points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "path"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "project_instructions",
            "rubric",
            "dataset",
            "reference_solution",
            "instructor_guidance",
            "calibration_ruling",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Prefer a path relative to the project root."
        },
        "description": {
          "type": "string"
        },
        "required_for_grading": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable_id",
        "description",
        "required"
      ],
      "properties": {
        "deliverable_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "file_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applies_to_tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_rule": {
          "type": "string",
          "enum": [
            "follow_criterion_rules",
            "flag_for_review",
            "zero_affected_criteria"
          ],
          "default": "follow_criterion_rules"
        },
        "notes": {
          "type": "string"
        },
        "presence_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Patterns for anonymized filenames used to establish file presence independently of required original naming."
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "max_points",
        "criteria"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "max_points": {
          "type": "number",
          "minimum": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "review_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "description",
        "requirement_type",
        "max_points",
        "full_credit_condition"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requirement_type": {
          "type": "string",
          "enum": [
            "technical_correctness",
            "required_method",
            "data_handling",
            "numerical_result",
            "visualization",
            "engineering_interpretation",
            "deliverable",
            "reproducibility",
            "organization",
            "documentation",
            "other"
          ]
        },
        "max_points": {
          "type": "number",
          "minimum": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_requirement": {
          "$ref": "#/$defs/method_requirement"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "full_credit_condition": {
          "type": "string",
          "minLength": 1
        },
        "deduction_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deduction_rule"
          }
        },
        "acceptable_alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Criterion IDs whose results may affect this criterion."
        },
        "error_propagation": {
          "$ref": "#/$defs/error_propagation"
        },
        "review_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feedback_guidance": {
          "type": "string"
        }
      }
    },
    "method_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "not_prescribed",
            "required",
            "preferred"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptable_alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "description",
        "required"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": [
            "source_code",
            "numerical_output",
            "plot",
            "model_file",
            "spreadsheet",
            "notebook",
            "written_response",
            "execution_result",
            "file_presence",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "artifact_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "location_hint": {
          "type": "string",
          "description": "Optional worksheet, notebook section, function, model block, or other location hint."
        },
        "verification": {
          "type": "string",
          "enum": [
            "inspect",
            "execute",
            "calculate",
            "compare",
            "presence_only",
            "manual_review"
          ]
        }
      }
    },
    "deduction_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "condition",
        "deduction_points"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "deduction_points": {
          "type": "number",
          "minimum": 0
        },
        "feedback_template": {
          "type": "string"
        },
        "review_if_uncertain": {
          "type": "boolean",
          "default": true
        },
        "basis": {
          "type": "string",
          "enum": [
            "technical",
            "filename",
            "file_presence"
          ]
        },
        "deliverable_id": {
          "type": "string",
          "minLength": 1
        },
        "max_applications": {
          "type": "integer",
          "minimum": 1
        },
        "allow_shared_cause": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "error_propagation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "independent",
            "follow_through_credit",
            "instructor_review"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguity_id",
        "description",
        "status"
      ],
      "properties": {
        "ambiguity_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task IDs or criterion IDs affected by this ambiguity."
        },
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "agent_proposed_interpretation": {
          "type": "string"
        },
        "instructor_ruling": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
