# AI Grader settings. install.py copies this file to .env (in this folder)
# and fills in the values. Never commit .env or share the API key.

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_MODEL=

# Person who reviews and approves grading specifications (needed by approve-spec)
GRADER_INSTRUCTOR_NAME=

# Anthropic: planned, not yet supported. AI Grader ignores these today.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
